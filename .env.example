NO_OVERTIME_ENV=development

RENDERER_HOST=127.0.0.1
RENDERER_PORT=5173
API_HOST=127.0.0.1
API_PORT=28780
VITE_API_BASE_URL=http://127.0.0.1:28780/v1

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55430
POSTGRES_DB=no_overtime_dev
