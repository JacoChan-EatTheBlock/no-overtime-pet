# ═══════════════════════════════════════════════════════════
# 不要加班 — 环境变量 (全云端方案)
# 复制为 .env.local 填入真实值
# ═══════════════════════════════════════════════════════════

# ─── Supabase (Auth + PostgreSQL + Storage) ────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Upstash Redis (Realtime + Cache + Rate Limit) ─────────
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=AX...

# ─── AI / LLM Provider (硅基流动 SiliconFlow) ─────────────
# OpenAI 兼容接口，支持 Qwen/DeepSeek/GLM 等模型
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 备选模型:
#   deepseek-ai/DeepSeek-V3
#   Qwen/Qwen2.5-Coder-32B-Instruct
#   THUDM/glm-4-9b-chat
#   Pro/Qwen/Qwen2.5-72B-Instruct (更快)

# ─── AI Service 地址 ──────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── NestJS API ────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Realtime Gateway ─────────────────────────────────────
REALTIME_PORT=3001

# ─── Object Storage (Supabase Storage) ────────────────────
STORAGE_BUCKET=assets

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
